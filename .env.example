# Copy to .env.local (not committed) to override values for your machine.

# Base URL the browser uses for API calls.
# - Development: /api (forwarded to the backend by the Vite proxy)
# - Production behind the same domain: /api (configure your web server to forward it)
# - Production on another domain: https://api.example.com (then FastAPI needs CORSMiddleware)
VITE_API_BASE_URL=/api

# Not a VITE_ variable, so it is never exposed to the browser.
# Only used by the dev proxy in vite.config.ts. Default: http://127.0.0.1:8000
# BACKEND_URL=http://127.0.0.1:8000
